+
+export function whisperFor(
+  rules: readonly WhisperRule[],
+  id: string,
+  status: PolaroidStatus,
+): WhisperRule | undefined {
+  return rules.find((rule) => rule.id === id && (!rule.only || rule.only.includes(status)));
