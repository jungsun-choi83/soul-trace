OPENAI_API_KEY=your_openai_api_key_here
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# 배포 URL (OG/절대 링크용). 로컬은 비우거나 http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://soultrace.eternalbeam.com

# 메인 브랜드 사이트 (이터널빔닷컴). 비우면 https://eternalbeam.com 사용
NEXT_PUBLIC_ETERNALBEAM_HOME_URL=https://eternalbeam.com

# 공식 인스타그램 프로필
NEXT_PUBLIC_ETERNALBEAM_INSTAGRAM_URL=https://www.instagram.com/eternalbeam/

# 배경 이미지(이미지 API) 생략 — 1/true/yes/on 이면 편지만 생성. 비용·응답 시간 크게 절감
# SOUL_TRACE_SKIP_HERO_IMAGE=1

# 첫 편지 생성 시 배경 이미지 API 생략(클라이언트가 skipImageGeneration 전송). 대기 시간 단축
# NEXT_PUBLIC_SKIP_RESULT_HERO_IMAGE=1

# 결과 화면 배경음(절대 URL). 비우면 `public/audio/result-ambient.mp3` 사용.
# NEXT_PUBLIC_RESULT_BGM_URL=

# Google 시트 적재(선택). Supabase 저장 성공 후 같은 내용을 POST로 전송.
# Apps Script로 웹 앱 배포한 URL. 비우면 시트로 보내지 않음.
# GOOGLE_SHEETS_WEB_APP_URL=https://script.google.com/macros/s/xxxx/exec
# Apps Script에서 검증용(스크립트 속성 INGEST_SECRET과 동일하게 두는 것을 권장)
# GOOGLE_SHEETS_INGEST_SECRET=

# ── Eternal Beam 핸드오프 (Phase 10.5) ───────────────────────────────────────
# Soul Trace 와 Eternal Beam 은 **서로 다른 Supabase 프로젝트**를 쓴다.
# 교차 DB 조회를 하지 않으며, service-role 키를 공유하지도 않는다.
# 두 프로젝트가 공유하는 비밀은 이 토큰 **하나뿐**이다.
#
# 이 값을 요구하는 라우트:
#   POST /api/internal/letter      핸드오프 교환 → 정본 편지 (서버 대 서버 전용)
#   GET  /api/customer-data        기기 연동 조회 (예전에는 인증이 없었다)
#
# ⚠️ NEXT_PUBLIC_ 접두사를 붙이지 마라 — 붙이는 순간 브라우저 번들에 박힌다.
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SOUL_TRACE_SERVICE_TOKEN=

# 핸드오프 도착지. 비우면 https://device.eternalbeam.com/soul-trace/import 사용
# NEXT_PUBLIC_ETERNALBEAM_IMPORT_URL=https://device.eternalbeam.com/soul-trace/import
